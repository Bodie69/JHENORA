<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_surface_container_low"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/m3_surface"
        android:orientation="vertical"
        android:padding="@dimen/spacing_base"
        android:paddingTop="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_events"
            android:textColor="@color/m3_on_surface"
            android:textSize="@dimen/text_3xl"
            android:textStyle="bold"
            android:fontFamily="@font/google_sans" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_search_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/iv_search"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                android:contentDescription="@null"
                app:tint="@color/m3_on_surface_variant" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@null"
                android:hint="@string/hint_search_events"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:textColor="@color/m3_on_surface"
                android:textColorHint="@color/m3_on_surface_variant"
                android:textSize="@dimen/text_base" />

        </LinearLayout>

    </LinearLayout>

    <!-- Filters -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="@color/m3_surface">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_base"
            android:paddingBottom="12dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_upcoming"
                style="@style/Widget.JHENORA.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/filter_upcoming" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_past"
                style="@style/Widget.JHENORA.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/filter_past" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_any_time"
                style="@style/Widget.JHENORA.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/filter_any_time" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_all"
                style="@style/Widget.JHENORA.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/filter_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_general"
                style="@style/Widget.JHENORA.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/filter_general" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_bsit"
                style="@style/Widget.JHENORA.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="BSIT" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_btled"
                style="@style/Widget.JHENORA.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="BTLED" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_educ"
                style="@style/Widget.JHENORA.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EDUC" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Shown while the list below is the saved offline copy -->
    <TextView
        android:id="@+id/tv_offline_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/warning_light"
        android:gravity="center"
        android:paddingHorizontal="@dimen/spacing_base"
        android:paddingVertical="8dp"
        android:text="@string/offline_showing_saved"
        android:textColor="@color/m3_on_surface"
        android:textSize="@dimen/text_sm"
        android:visibility="gone" />

    <!-- Content (FrameLayout lets the FAB float over the list rather than sit inline) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_events"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/spacing_base"
                android:paddingTop="@dimen/spacing_sm"
                android:paddingBottom="96dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <TextView
                android:id="@+id/tv_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/no_events"
                android:textColor="@color/m3_on_surface_variant"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progress_load_more"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

        </FrameLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fab"
            style="@style/Widget.JHENORA.ExtendedFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/spacing_base"
            android:contentDescription="Create Event"
            android:text="@string/fab_new_event"
            app:icon="@android:drawable/ic_input_add"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
