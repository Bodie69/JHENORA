<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_md"
    app:cardCornerRadius="@dimen/corner_lg"
    app:cardElevation="0dp"
    app:strokeColor="@color/gray_200"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_base">

        <!-- Logo slot: uploaded logo when present, otherwise the department code badge.
             The slot itself is the upload button (the small badge hints that it's tappable). -->
        <FrameLayout
            android:id="@+id/frame_logo"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="@dimen/spacing_base"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/dept_logo_actions">

            <LinearLayout
                android:id="@+id/layout_code_badge"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_circle_primary"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_xs"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Uploaded logos are pre-trimmed and centred on a square PNG at upload time
                 (SupabaseStorage.uploadLogo), so centerCrop fills the circle edge to edge.
                 Circular white backing shows through transparent logos; the hairline ring
                 is drawn inside the edge (padding = half the stroke) so it isn't clipped. -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_logo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_circle_white"
                android:contentDescription="@null"
                android:padding="0.5dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.JHENORA.Circle"
                app:strokeColor="@color/gray_200"
                app:strokeWidth="1dp" />

            <ImageView
                android:id="@+id/iv_logo_edit"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_logo_edit_badge"
                android:contentDescription="@null"
                android:elevation="2dp"
                android:padding="5dp"
                android:src="@drawable/ic_image"
                app:tint="@color/white" />

            <ProgressBar
                android:id="@+id/progress_logo"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/primary"
                android:visibility="gone" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_base"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_sm" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
