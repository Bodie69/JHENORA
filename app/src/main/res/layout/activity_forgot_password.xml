<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Back button (iOS Style) -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back_ios"
            app:tint="@color/primary"
            android:contentDescription="Back"
            android:padding="4dp" />

        <!-- Step 1: Enter email -->
        <LinearLayout
            android:id="@+id/layout_step_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="@string/title_forgot_password"
                android:textColor="@color/text_primary"
                android:textSize="34sp"
                android:textStyle="bold"
                android:fontFamily="@font/google_sans" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/subtitle_forgot_password_email"
                android:textColor="@color/text_secondary"
                android:textSize="17sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:background="@drawable/bg_ios_card"
                android:orientation="vertical"
                android:elevation="0dp">

                <EditText
                    android:id="@+id/et_email"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@android:color/transparent"
                    android:hint="@string/label_email"
                    android:inputType="textEmailAddress"
                    android:paddingHorizontal="16dp"
                    android:textSize="17sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_send_code"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="32dp"
                android:text="@string/btn_send_code"
                android:textAllCaps="false"
                android:textSize="17sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/primary"
                app:elevation="0dp" />

        </LinearLayout>

        <!-- Step 2: Verify OTP -->
        <LinearLayout
            android:id="@+id/layout_step_otp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="@string/title_verify_code"
                android:textColor="@color/text_primary"
                android:textSize="34sp"
                android:textStyle="bold"
                android:fontFamily="@font/google_sans" />

            <TextView
                android:id="@+id/tv_otp_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/subtitle_verify_code"
                android:textColor="@color/text_secondary"
                android:textSize="17sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:background="@drawable/bg_ios_card"
                android:orientation="vertical"
                android:elevation="0dp">

                <EditText
                    android:id="@+id/et_otp"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@android:color/transparent"
                    android:hint="@string/hint_otp_code"
                    android:inputType="number"
                    android:maxLength="12"
                    android:letterSpacing="0.3"
                    android:paddingHorizontal="16dp"
                    android:textSize="17sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_resend_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="16dp"
                android:text="@string/btn_resend_code"
                android:textColor="@color/primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_verify_code"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:text="@string/btn_verify_code"
                android:textAllCaps="false"
                android:textSize="17sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/primary"
                app:elevation="0dp" />

        </LinearLayout>

        <!-- Step 3: New password -->
        <LinearLayout
            android:id="@+id/layout_step_new_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="@string/title_reset_password"
                android:textColor="@color/text_primary"
                android:textSize="34sp"
                android:textStyle="bold"
                android:fontFamily="@font/google_sans" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/subtitle_reset_password"
                android:textColor="@color/text_secondary"
                android:textSize="17sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:background="@drawable/bg_ios_card"
                android:orientation="vertical"
                android:elevation="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp">

                    <EditText
                        android:id="@+id/et_new_password"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:hint="@string/label_new_password"
                        android:inputType="textPassword"
                        android:paddingStart="16dp"
                        android:paddingEnd="48dp"
                        android:textSize="17sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint" />

                    <ImageButton
                        android:id="@+id/btn_toggle_new_password"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="16dp"
                        android:background="@android:color/transparent"
                        android:padding="0dp"
                        android:src="@drawable/ic_eye"
                        app:tint="@color/text_secondary"
                        android:contentDescription="@string/toggle_password_visibility" />
                </FrameLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/gray_200" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp">

                    <EditText
                        android:id="@+id/et_confirm_new_password"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:hint="@string/label_confirm_new_password"
                        android:inputType="textPassword"
                        android:paddingStart="16dp"
                        android:paddingEnd="48dp"
                        android:textSize="17sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint" />

                    <ImageButton
                        android:id="@+id/btn_toggle_confirm_new_password"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="16dp"
                        android:background="@android:color/transparent"
                        android:padding="0dp"
                        android:src="@drawable/ic_eye"
                        app:tint="@color/text_secondary"
                        android:contentDescription="@string/toggle_password_visibility" />
                </FrameLayout>

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reset_password"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="32dp"
                android:text="@string/btn_reset_password"
                android:textAllCaps="false"
                android:textSize="17sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/primary"
                app:elevation="0dp" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
