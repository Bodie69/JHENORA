<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_surface_container_low"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/m3_surface"
        android:orientation="vertical"
        android:paddingTop="48dp"
        android:paddingBottom="@dimen/spacing_sm">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_base"
            android:fontFamily="@font/google_sans"
            android:text="@string/title_calendar"
            android:textColor="@color/m3_on_surface"
            android:textSize="@dimen/text_3xl"
            android:textStyle="bold" />

        <!-- Rolling date strip: Today, Tomorrow, then upcoming dates -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_dates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/spacing_sm" />

    </LinearLayout>

    <!-- Selected day's agenda -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_day_events"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/spacing_base"
            android:paddingTop="@dimen/spacing_base"
            android:paddingBottom="@dimen/spacing_base"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <TextView
            android:id="@+id/tv_no_events"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/no_events_on_date"
            android:textColor="@color/m3_on_surface_variant"
            android:textSize="@dimen/text_base"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
