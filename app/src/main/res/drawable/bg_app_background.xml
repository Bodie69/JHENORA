<?xml version="1.0" encoding="utf-8"?>
<!-- Window background: a soft cool wash fading from a faint brand tint at the top to the
     page colour, giving screens depth behind their content. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#E6EEFF"
        android:centerColor="@color/background"
        android:endColor="@color/background"
        android:type="linear" />
</shape>
