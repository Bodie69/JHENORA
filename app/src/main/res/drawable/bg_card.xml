<?xml version="1.0" encoding="utf-8"?>
<!-- Card surface: barely-there white -> cool tint gradient plus a blue-tinted hairline,
     so cards separate from the page without heavy borders. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/surface"
        android:endColor="@color/brand_surface_tint"
        android:type="linear" />
    <corners android:radius="@dimen/corner_lg" />
    <stroke
        android:width="1dp"
        android:color="@color/gray_200" />
</shape>
