<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom navigation bar: horizontal deep -> royal -> deep sweep with a hairline highlight
     on top so the bar reads as a raised surface. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/brand_deep"
                android:centerColor="@color/brand_mid"
                android:endColor="@color/brand_deep"
                android:type="linear" />
        </shape>
    </item>
    <item android:gravity="top" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
