<?xml version="1.0" encoding="utf-8"?>
<!-- Wash over the Welcome hero's campus photo (welcome_campus.jpg, pre-blurred): brand navy
     at the top behind the logo and title, easing through royal blue so the building shows in
     the middle, then deepening again where the welcome card overlaps. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#D900237A"
        android:centerColor="#8C0047C2"
        android:endColor="#E600237A"
        android:type="linear" />
</shape>
