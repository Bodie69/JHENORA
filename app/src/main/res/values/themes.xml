<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.JHENORA" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:navigationBarColor">@color/nav_bar</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="materialButtonStyle">@style/Widget.JHENORA.Button</item>
        <item name="textInputStyle">@style/Widget.JHENORA.TextInputLayout</item>
    </style>

    <style name="Theme.JHENORA.Splash" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:navigationBarColor">@color/primary</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="android:colorBackground">@color/primary</item>
    </style>

    <style name="Theme.JHENORA.FullScreen" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/gray_900</item>
        <item name="android:navigationBarColor">@color/gray_900</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSurface">@color/gray_900</item>
        <item name="android:colorBackground">@color/gray_900</item>
    </style>

    <!-- Button Styles -->
    <style name="Widget.JHENORA.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">@dimen/corner_full</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:minHeight">@dimen/button_height</item>
    </style>

    <style name="Widget.JHENORA.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/corner_full</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="strokeColor">@color/primary</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="Widget.JHENORA.Button.Danger" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">@dimen/corner_full</item>
        <item name="backgroundTint">@color/danger</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:minHeight">@dimen/button_height</item>
    </style>

    <style name="Widget.JHENORA.Button.Success" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">@dimen/corner_full</item>
        <item name="backgroundTint">@color/success</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:minHeight">@dimen/button_height</item>
    </style>

    <!-- TextInputLayout Styles -->
    <style name="Widget.JHENORA.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/corner_lg</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_lg</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_lg</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_lg</item>
        <item name="boxStrokeColor">@color/stroke</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>

    <!-- Card Styles -->
    <style name="Widget.JHENORA.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/corner_lg</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="strokeColor">@color/gray_200</item>
    </style>

    <!-- Text Styles -->
    <style name="TextStyle.JHENORA" parent="android:TextAppearance">
        <item name="android:fontFamily">@font/google_sans</item>
    </style>

    <style name="TextStyle.JHENORA.Heading1">
        <item name="android:textSize">@dimen/text_3xl</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/google_sans</item>
    </style>

    <style name="TextStyle.JHENORA.Heading2">
        <item name="android:textSize">@dimen/text_2xl</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextStyle.JHENORA.Heading3">
        <item name="android:textSize">@dimen/text_xl</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextStyle.JHENORA.Body">
        <item name="android:textSize">@dimen/text_base</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextStyle.JHENORA.Caption">
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextStyle.JHENORA.Label">
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Chip Styles (applied to com.google.android.material.chip.Chip views) -->
    <style name="Widget.JHENORA.Chip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="chipCornerRadius">@dimen/corner_full</item>
        <item name="chipBackgroundColor">@color/chip_state</item>
        <item name="android:textColor">@color/chip_text_state</item>
        <item name="android:textSize">@dimen/text_sm</item>
    </style>

    <!-- Bottom Sheet Style -->
    <style name="Widget.JHENORA.BottomSheet" parent="Widget.MaterialComponents.BottomSheet">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.JHENORA.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.JHENORA.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Toolbar Style -->
    <style name="Widget.JHENORA.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/surface</item>
        <item name="android:elevation">0dp</item>
        <item name="titleTextAppearance">@style/TextStyle.JHENORA.Heading2</item>
    </style>

    <!-- Dialog Style -->
    <style name="Widget.JHENORA.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.JHENORA.Dialog</item>
    </style>

    <style name="ShapeAppearance.JHENORA.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="ShapeAppearance.JHENORA.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Tab Layout Style -->
    <style name="Widget.JHENORA.TabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabBackground">@null</item>
        <item name="tabIndicatorColor">@color/primary</item>
        <item name="tabTextColor">@color/text_secondary</item>
        <item name="tabSelectedTextColor">@color/primary</item>
        <item name="tabTextAppearance">@style/TextStyle.JHENORA.Tab</item>
        <item name="tabIndicatorHeight">3dp</item>
    </style>

    <style name="TextStyle.JHENORA.Tab" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="textAllCaps">false</item>
        <item name="android:fontFamily">@font/google_sans</item>
    </style>

</resources>
